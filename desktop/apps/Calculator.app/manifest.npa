{
    "name": "Calculator",
    "version": "2.0.0",
    "bundle_id": "com.neolyx.calculator",
    "category": "Utilities",
    "description": "NeolyxOS Calculator (REOX)",

    "language": "reox",
    "sources": ["src/calculator.rx"],
    "sdk": "sdk/reox.mk",
    "binary": "bin/calculator",
    "icon": "resources/calculator.nxi",

    "permissions": [],

    "menu": {
        "edit": [
            { "label": "Copy", "action": "copy", "shortcut": "Cmd+C" },
            { "label": "Paste", "action": "paste", "shortcut": "Cmd+V" }
        ],
        "view": [
            { "label": "Basic", "action": "view_basic", "shortcut": "Cmd+1" }
        ]
    },

    "requirements": {
        "os_version": "1.0.0",
        "drivers": ["nxgfx"],
        "runtime": ["librx_neolyx", "nxrender"]
    },

    "author": "KetiveeAI",
    "copyright": "Copyright (c) 2025 KetiveeAI",
    "license": "Proprietary"
}
