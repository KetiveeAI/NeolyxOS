# NeolyxOS Desktop - source lists
#
# Shared by the desktop Makefile (freestanding userspace build) and the
# host preview harness in tools/preview (renders frames to PNG on the
# development machine). Paths are relative to desktop/.
#
# Copyright (c) 2025 KetiveeAI

# Shell entry point (freestanding build only; the preview has its own main)
ENTRY_SRC = shell/main.c

# Syscall-backed stubs (both builds; memset/memcpy are freestanding only)
STUBS_SRC = shell/userspace_stubs.c

# The libc subset (freestanding build only; the preview uses the host libc)
FREESTANDING_SRC = lib/libc_stubs.c

# Shell components
# Note: compositor.c is excluded - desktop_shell.c has all functionality
# nx_malloc.c provides global heap allocator (must be single TU, not inline!)
SHELL_SRC = shell/desktop_shell.c \
            shell/nxui.c \
            shell/menubar.c \
            shell/app_drawer.c \
            shell/lock_screen.c \
            shell/window_manager.c \
            shell/dock.c \
            shell/wallpaper.c \
            shell/anveshan.c \
            shell/vm_detect.c \
            shell/control_center.c \
            shell/notification_center.c \
            shell/nxrender_bridge.c \
            shell/volume_osd.c \
            shell/keyboard_osd.c \
            shell/theme_osd.c \
            shell/battery_warning.c \
            shell/network_indicator.c \
            shell/yantra_grid.c \
            lib/nxappearance.c \
            lib/nxconfig.c \
            lib/nxevent.c \
            lib/nx_arena.c \
            lib/nx_malloc.c \
            lib/nxi_render.c \
            apps/Calendar.app/calendar_utils.c \
            ../config/nx_config.c

# ---- Desktop subsystem areas ----
# One line per area so parallel work merges cleanly. Each area appends
# its own new files to its own line only.
AREA_SHARED_SRC   = shell/app_views.c

AREA_GLASS_SRC    = lib/nxglass.c lib/nxframe.c

AREA_SETTINGS_SRC = shell/views/settings_view.c \
                    shell/views/settings_ui.c \
                    shell/views/settings_prefs.c \
                    shell/views/settings_dock_adapter.c \
                    shell/views/settings_sysinfo.c \
                    shell/views/settings_panes_system.c \
                    shell/views/settings_panes_look.c \
                    shell/views/settings_panes_input.c

AREA_FONTS_SRC    = shell/views/fonts_view.c \
                    lib/nxfont_registry.c

AREA_SETUP_SRC    = shell/views/setup_assistant.c shell/views/setup_pages.c shell/views/setup_store.c

AREA_DOCK_SRC     = shell/dock_menu.c shell/taskbar_bar.c

AREA_NET_SRC      = shell/views/settings_network_pane.c lib/nxnet.c

AREA_TASKMGR_SRC  = shell/views/taskmgr_view.c lib/nxproc.c

AREA_WINDOWS_SRC  = shell/stage.c shell/overview.c shell/switcher.c

AREA_PATH_SRC     = lib/nxpath_relay.c shell/views/path_view.c shell/desktop_items.c

AREA_SHELL_SRC    = shell/views/shell_view.c

AREA_NOTES_SRC    = shell/views/notes_view.c

AREA_NXSERVER_SRC = shell/nxserver/nxserver.c shell/nxserver/nxw_check.c

SHELL_SRC += $(AREA_SHARED_SRC) $(AREA_GLASS_SRC) $(AREA_SETTINGS_SRC) $(AREA_FONTS_SRC) \
             $(AREA_SETUP_SRC) $(AREA_DOCK_SRC) $(AREA_NET_SRC) $(AREA_TASKMGR_SRC) \
             $(AREA_WINDOWS_SRC) $(AREA_PATH_SRC) $(AREA_SHELL_SRC) $(AREA_NOTES_SRC) \
             $(AREA_NXSERVER_SRC)

WIDGET_SRC = widgets/widgets.c

# NXCanvas rendering engine and the vector icon set
NXCANVAS_SRC = lib/nxcanvas/nxc_core.c \
               lib/nxcanvas/nxc_math.c \
               lib/nxcanvas/nxc_paint.c \
               lib/nxcanvas/nxc_raster.c \
               lib/nxcanvas/nxc_shapes.c \
               lib/nxcanvas/nxc_image.c \
               lib/nxcanvas/nxc_effects.c \
               lib/nxcanvas/nxc_font.c \
               lib/nxcanvas/nxc_text.c

NXICONS_SRC = lib/nxicons/nxicons.c \
              lib/nxicons/nxapp_icons.c \
              lib/nxicons/nxicon_pack.c

# Embedded assets (system fonts; the NeolyxOS icon pack, generated by
# tools/build_icon_pack.py)
ASM_SRC = shell/nxui_assets.S \
          shell/nxicon_pack.S
